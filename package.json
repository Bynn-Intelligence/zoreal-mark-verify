{
  "name": "@zoreal/mark-verify",
  "version": "0.1.0",
  "description": "Verify a ZOREAL Mark: a live, chip-verified human vouched for exactly this text, here, then. The one verifier implementation, shared by the browser extensions, the verify page and the badge script.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bynn-Intelligence/zoreal-mark-verify.git"
  },
  "homepage": "https://zoreal.com",
  "keywords": [
    "zoreal",
    "mark",
    "content-signing",
    "verification",
    "signature",
    "provenance",
    "post-quantum"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "fixtures/records",
    "fixtures/anchors.json",
    "fixtures/index.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixtures": "npm run build && node scripts/make-fixtures.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.7.1",
    "@peculiar/asn1-cms": "^2.9.4",
    "@peculiar/asn1-schema": "^2.9.4",
    "@peculiar/asn1-tsp": "^2.9.4",
    "@peculiar/asn1-x509": "^2.9.4",
    "canonicalize": "^5.0.0",
    "tldts": "^7.4.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
